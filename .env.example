# Flask Security & Session Secret Key (64-char hex or strong random secret)
SECRET_KEY=generate_with_python_secrets_token_hex_32

# SIEM & EDR Webhook Ingestion API Key & HMAC Signing Secret
SIEM_WEBHOOK_API_KEY=generate_with_python_secrets_token_hex_32
SIEM_WEBHOOK_SECRET=generate_with_python_secrets_token_hex_32
SIEM_WEBHOOK_REQUIRE_SIGNATURE=True

# MySQL Database Configuration
DB_USERNAME=root
DB_PASSWORD=your_db_password_here
DB_HOST=localhost
DB_PORT=3306
DB_NAME=threat_intelligence_db

# External Threat Feeds
ABUSEIPDB_API_KEY=your_abuseipdb_key_here
VIRUSTOTAL_API_KEY=your_virustotal_key_here
OTX_API_KEY=your_otx_key_here

# Rate Limiting & Storage (Shared Redis for Multi-Worker WSGI)
RATELIMIT_ENABLED=True
RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# HTTPS / TLS Termination & HSTS
ENABLE_HSTS=True
BEHIND_PROXY=True
PROXY_FIX_FOR=1
PROXY_FIX_PROTO=1
